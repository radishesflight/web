# =====================================================
# web 项目环境变量示例
# 复制本文件为 .env.development / .env.production 后按需修改
#   cp .env.example .env.development
#   cp .env.example .env.production
# 真实 .env.* 文件已被 .gitignore 屏蔽,不会进库
#
# Vite 会自动加载 .env.[mode] 文件
# 变量必须以 VITE_ 开头才能在前端代码中访问
# =====================================================

# dev 模式
VITE_API_BASE=/api
VITE_API_TARGET=http://localhost:8080

# prod 模式(注释掉 dev 配置,启用 prod)
# VITE_API_BASE=https://api.example.com
# VITE_API_TARGET=https://api.example.com
